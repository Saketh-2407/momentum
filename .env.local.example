# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
# The new-format publishable key (sb_publishable_...) is preferred over the
# legacy anon JWT — both work with the installed @supabase/supabase-js, but
# Supabase is moving new projects toward the new format.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI planner provider — Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google Cloud OAuth client (Gmail + Calendar smart triage, Phase 5)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/connectors/google/callback

# Site URL (used for OAuth callbacks, absolute links, share cards)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Symmetric key (AES-256-GCM) encrypting connector refresh tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
